// ============================================================================
// CLOCK & RESET
// ============================================================================
IO_LOC "clk"   52;
IO_PORT "clk"  IO_TYPE=LVCMOS33;
// Onboard button net PIN3_IOT2A_BUTTON_S1_1V8. Pin 4 is JTAGSEL_N.
IO_LOC "rst_n" 3;
IO_PORT "rst_n" PULL_MODE=UP IO_TYPE=LVCMOS18;

// ============================================================================
// UART
// ============================================================================
// External CP2102: FPGA TX pin 41 -> CP2102 RXD.
IO_LOC "uart_tx" 41;
IO_PORT "uart_tx" IO_TYPE=LVCMOS33;
IO_LOC "uart_rx" 42;
IO_PORT "uart_rx" PULL_MODE=UP IO_TYPE=LVCMOS33;

// ============================================================================
// BUTTONS 
// ============================================================================
IO_LOC "buttons[0]" 25;
IO_PORT "buttons[0]" PULL_MODE=UP IO_TYPE=LVCMOS33;
IO_LOC "buttons[1]" 26;
IO_PORT "buttons[1]" PULL_MODE=UP IO_TYPE=LVCMOS33;
IO_LOC "buttons[2]" 27;
IO_PORT "buttons[2]" PULL_MODE=UP IO_TYPE=LVCMOS33;
IO_LOC "buttons[3]" 28;
IO_PORT "buttons[3]" PULL_MODE=UP IO_TYPE=LVCMOS33;

// ============================================================================
// LEDs — Tang Nano 9K LED mặc định chân 10,11,13,14,15,16
// ============================================================================
IO_LOC "leds[0]" 10;
IO_PORT "leds[0]" IO_TYPE=LVCMOS18;
IO_LOC "leds[1]" 11;
IO_PORT "leds[1]" IO_TYPE=LVCMOS18;
IO_LOC "leds[2]" 13;
IO_PORT "leds[2]" IO_TYPE=LVCMOS18;
IO_LOC "leds[3]" 14;
IO_PORT "leds[3]" IO_TYPE=LVCMOS18;
IO_LOC "leds[4]" 15;
IO_PORT "leds[4]" IO_TYPE=LVCMOS18;
IO_LOC "leds[5]" 16;
IO_PORT "leds[5]" IO_TYPE=LVCMOS18;

// ============================================================================
// 7-SEGMENT SEGMENTS — BANK2 (3.3V)
// ============================================================================
IO_LOC "seg_data[0]" 72;
IO_PORT "seg_data[0]" IO_TYPE=LVCMOS33;
IO_LOC "seg_data[1]" 73;
IO_PORT "seg_data[1]" IO_TYPE=LVCMOS33;
IO_LOC "seg_data[2]" 74;
IO_PORT "seg_data[2]" IO_TYPE=LVCMOS33;
IO_LOC "seg_data[3]" 75;
IO_PORT "seg_data[3]" IO_TYPE=LVCMOS33;
IO_LOC "seg_data[4]" 76;
IO_PORT "seg_data[4]" IO_TYPE=LVCMOS33;
IO_LOC "seg_data[5]" 77;
IO_PORT "seg_data[5]" IO_TYPE=LVCMOS33;
IO_LOC "seg_data[6]" 71;
IO_PORT "seg_data[6]" IO_TYPE=LVCMOS33;

// ============================================================================
// MOTOR & BUZZER
// ============================================================================
IO_LOC "motor_pins[0]" 29;
IO_LOC "motor_pins[1]" 30;
IO_LOC "motor_pins[2]" 33;
IO_LOC "motor_pins[3]" 34;
IO_PORT "motor_pins[0]" IO_TYPE=LVCMOS33 DRIVE=8;
IO_PORT "motor_pins[1]" IO_TYPE=LVCMOS33 DRIVE=8;
IO_PORT "motor_pins[2]" IO_TYPE=LVCMOS33 DRIVE=8;
IO_PORT "motor_pins[3]" IO_TYPE=LVCMOS33 DRIVE=8;

IO_LOC "buzzer_pin" 70;
IO_PORT "buzzer_pin" IO_TYPE=LVCMOS33 DRIVE=8;

// ============================================================================
// LED CHÂN NGOÀI (48 & 49)
// ============================================================================
IO_LOC "led_up"   48;
IO_LOC "led_down" 49;
IO_PORT "led_up"   IO_TYPE=LVCMOS33 DRIVE=8;
IO_PORT "led_down" IO_TYPE=LVCMOS33 DRIVE=8;

// ============================================================================
// SERVO CỬA (PWM 50Hz)
// ============================================================================
IO_LOC "servo_pin" 51;
IO_PORT "servo_pin" IO_TYPE=LVCMOS33 DRIVE=8;
